{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apollo Download Manager",
  "identifier": "com.velocity.downloadmanager.v2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Apollo Download Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm"],
    "publisher": "Singlbase Technologies Limited",
    "copyright": "Copyright (C) 2026 Singlbase Technologies Limited",
    "license": "GPL-3.0-only",
    "category": "Utility",
    "shortDescription": "A desktop download manager.",
    "externalBin": ["binaries/velocity-transfer", "binaries/velocity-torrent", "binaries/velocity-native-host-v2"],
    "resources": {
      "staging/LICENSE": "LICENSE",
      "staging/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "staging/build-info.json": "build-info.json"
    },
    "linux": {
      "deb": {
        "section": "net",
        "conflicts": ["velocity-download-manager-v2"],
        "replaces": ["velocity-download-manager-v2"]
      },
      "rpm": {
        "obsoletes": ["velocity-download-manager-v2"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
